# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Checkpoints and run artifacts are reproducible from configs; keep the dirs, drop the blobs.
checkpoints/*
!checkpoints/.gitkeep
runs/*
!runs/.gitkeep

# Third party research papers are kept locally but never redistributed.
# references/README.md lists them with links to the originals.
references/*.pdf
*.pdf

# Archive bundles duplicate folders that are already committed unzipped.
*.zip

# Large derived artifacts. Every one of these is regenerated by rerunning the
# scripts that produced it, so they do not belong in git history.
experiments/01-toy-latents/results/rollout_predictions.npz
experiments/01-toy-latents/results/demo.html
experiments/*/results/ckpt/
# Whole run folders downloaded from Google Drive (checkpoints, cached evaluations,
# datasets: hundreds of MB). Only their results/ subfolder is committed, copied out
# next to the notebook that produced it.
experiments/*/exp3-*-results-*/
experiments/*/medium-*Z-*-001*/
# Local staging folder where run outputs are gathered by hand for a write up. Every
# file in it is already committed at its canonical path next to its notebook.
experiments/*/allv3 data for publication/
*.log

.DS_Store
.streamlit/secrets.toml
